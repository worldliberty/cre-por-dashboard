# USD1 Proof of Reserves Dashboard — Environment Variables
# Copy this file to `.env.local` and fill in the values you need.

# Google Analytics measurement ID (optional).
# When unset, analytics are completely disabled — no scripts are loaded.
# When set, the privacy-first implementation respects Do Not Track (DNT)
# and Global Privacy Control (GPC) browser signals.
NEXT_PUBLIC_GOOGLE_ID="G-XXXXXXXXXX"
